{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADFmayao"
		},
		"LS_SQL_PAR_PUTPUT_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_SQL_PAR_PUTPUT'"
		},
		"LS_SQL_TO_PAR_INPUT_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_TO_PAR_INPUT'"
		},
		"LS_SQL_PAR_PUTPUT_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://siaslsmaya.dfs.core.windows.net/"
		},
		"LS_SQL_TO_PAR_INPUT_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "DESKTOP-IHSFEQB\\SQLEXPRESS"
		},
		"LS_SQL_TO_PAR_INPUT_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "salesecom"
		},
		"LS_SQL_TO_PAR_INPUT_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADFmayao_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2018-02-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SQL_PAR_PUTPUT_accountKey": {
						"value": "[parameters('LS_SQL_PAR_PUTPUT_accountKey')]"
					},
					"LS_SQL_TO_PAR_INPUT_password": {
						"value": "[parameters('LS_SQL_TO_PAR_INPUT_password')]"
					},
					"LS_SQL_PAR_PUTPUT_properties_typeProperties_url": {
						"value": "[parameters('LS_SQL_PAR_PUTPUT_properties_typeProperties_url')]"
					},
					"LS_SQL_TO_PAR_INPUT_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_TO_PAR_INPUT_properties_typeProperties_server')]"
					},
					"LS_SQL_TO_PAR_INPUT_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_TO_PAR_INPUT_properties_typeProperties_database')]"
					},
					"LS_SQL_TO_PAR_INPUT_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_TO_PAR_INPUT_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}